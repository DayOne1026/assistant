# assistant 全平台配置示例（12 部署）。
# 复制为 .env 使用：`cp .env.example .env`，敏感项（secret/api_key/密码）生产必须改。
# env 前缀 ASSISTANT_（app/core/config.py Settings）。Docker 内 URL 用 compose 服务名（postgres/redis/neo4j）。

# 基础
ASSISTANT_APP_NAME=assistant
ASSISTANT_ENV=dev
ASSISTANT_API_PREFIX=/api/v1

# JWT（02）；生产 secret 必须 ≥32 字节
ASSISTANT_SECRET_KEY=dev-secret-change-me-to-32-bytes-plus
ASSISTANT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ASSISTANT_REFRESH_TOKEN_EXPIRE_DAYS=7
ASSISTANT_TIMEZONE=Asia/Shanghai

# PostgreSQL（pgvector）；应用用非 superuser 角色 assistant_app（03 RLS 对 superuser 静默失效）
ASSISTANT_DATABASE_URL=postgresql+asyncpg://assistant_app:assistant@postgres:5432/assistant
ASSISTANT_PG_ECHO=false
ASSISTANT_POOL_SIZE=10
ASSISTANT_MAX_OVERFLOW=20

# Redis
ASSISTANT_REDIS_URL=redis://redis:6379/0

# Neo4j
ASSISTANT_NEO4J_URI=bolt://neo4j:7687
ASSISTANT_NEO4J_USER=neo4j
ASSISTANT_NEO4J_PASSWORD=dev-password-change-me
ASSISTANT_NEO4J_DATABASE=neo4j

# LLM（01，DeepSeek；可切千问 ChatTongyi）
ASSISTANT_LLM_PROVIDER=deepseek
ASSISTANT_LLM_MODEL=deepseek-chat
ASSISTANT_LLM_API_KEY=change-me
ASSISTANT_LLM_BASE_URL=https://api.deepseek.com
ASSISTANT_VISION_MODEL=qwen-vl-max

# Embedding（06）：本地 BGE，离线可用
ASSISTANT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
ASSISTANT_EMBEDDING_DIM=512

# Celery（08/10/12）broker/backend 分开 DB 防互踩
ASSISTANT_CELERY_BROKER_URL=redis://redis:6379/1
ASSISTANT_CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS 白名单（不用 *）
ASSISTANT_CORS_ORIGINS=["http://localhost:3000"]

# 限流 / 有害过滤（11）
ASSISTANT_RATE_LIMIT_MAX=60
ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=60
ASSISTANT_RATE_LIMIT_ENABLED=true
ASSISTANT_HARMFUL_FILTER_ENABLED=true

# OAuth（09）
ASSISTANT_OAUTH_TOKEN_ENCRYPTION_KEY=dev-key-change-me
ASSISTANT_OAUTH_REDIRECT_BASE=http://localhost:8000/api/v1/integrations
ASSISTANT_GOOGLE_OAUTH_CLIENT_ID=
ASSISTANT_GOOGLE_OAUTH_CLIENT_SECRET=
ASSISTANT_OUTLOOK_OAUTH_CLIENT_ID=
ASSISTANT_OUTLOOK_OAUTH_CLIENT_SECRET=
ASSISTANT_JWT_BLACKLIST_ENABLED=true

# SMTP（08 email 渠道；留空则 send_email 跳过）
ASSISTANT_SMTP_HOST=
ASSISTANT_SMTP_PORT=587
ASSISTANT_SMTP_USER=
ASSISTANT_SMTP_PASSWORD=
ASSISTANT_SMTP_FROM=assistant@localhost

# 图片库（06，CLIP 本地向量）
ASSISTANT_IMAGE_EMBEDDING_MODEL=clip-ViT-B-32
ASSISTANT_IMAGE_EMBEDDING_DIM=512

# 文件存储（06）
ASSISTANT_STORAGE_ROOT=storage

# RAG 索引（06/12）：True 走 Celery 异步索引（需 worker 部署），False 同步
ASSISTANT_INDEXING_ASYNC=false

# 联网搜索（06 web_search）
ASSISTANT_TAVILY_API_KEY=

# OTel（12）
ASSISTANT_OTEL_ENABLED=false
ASSISTANT_OTEL_SERVICE_NAME=assistant
